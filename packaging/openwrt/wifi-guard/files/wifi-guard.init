#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
START=95
STOP=10
USE_PROCD=1

start_service() {
	umask 077
	procd_open_instance
	procd_set_param command /usr/sbin/wifi-guard
	procd_set_param env GOMEMLIMIT=12MiB GOGC=50
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wifi-guard
	procd_close_instance
}

reload_service() {
	# Restart only this monitor; never reload wireless, networking or rpcd here.
	/etc/init.d/wifi-guard restart
}

service_triggers() {
	procd_add_reload_trigger wifi-guard
}
